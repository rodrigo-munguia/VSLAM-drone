Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: Odometry
      Topic:
        Value: /odometry
      Keep: 100
      Shape:
        Value: Arrow
      Position Tolerance: 0.01
      Angle Tolerance: 0.01
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Landmarks
      Topic:
        Value: /EKFslam/landmarks
      Size (m): 0.08
      Style: Spheres
      Color Transformer: FlatColor
      Color: 255; 170; 0
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Estimated Path
      Topic:
        Value: /EKFslam/path
      Line Style: Lines
      Line Width: 0.03
      Color: 25; 255; 0
      Pose Style: None
      Buffer Length: 1
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Ground Truth Path
      Topic:
        Value: /ground_truth/path
      Line Style: Lines
      Line Width: 0.03
      Color: 255; 64; 64
      Pose Style: None
      Buffer Length: 1
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Global Keyframes
      Topic:
        Value: /gslam/global_keyframes
      Line Style: Lines
      Line Width: 0.04
      Color: 0; 200; 255
      Pose Style: None
      Buffer Length: 1
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Global Landmarks
      Topic:
        Value: /gslam/global_landmarks
      Size (m): 0.1
      Style: Spheres
      Color Transformer: FlatColor
      Color: 255; 0; 200
  Enabled: true
  Global Options:
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.6
      Yaw: 0.8
Window Geometry:
  Height: 800
  Width: 1200
