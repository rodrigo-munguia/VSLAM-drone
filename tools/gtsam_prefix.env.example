# Example environment for a user-owned GTSAM prefix (not committed as a real path).
# Copy to an untracked file (e.g. tools/gtsam_prefix.env) and edit GTSAM_PREFIX.
#
# Integrated launch (./launch2.sh --globalslam true) auto-loads this file via
# tools/ensure_gtsam_runtime.sh when present. Manual build/run:
#
#   set -a && source tools/gtsam_prefix.env && set +a
#   source /opt/ros/jazzy/setup.bash
#   colcon build --packages-select interfaces globalslam \
#     --build-base build --install-base install
#
# If this file is absent, ensure_gtsam_runtime.sh also tries GTSAM_PREFIX and
# repo-relative deps/gtsam-4.2.0, ../deps/gtsam-4.2.0, ../../deps/gtsam-4.2.0.
#
# Validated with borglab/gtsam tag 4.2.0 (matches ros-jazzy-gtsam 4.2.0).

GTSAM_PREFIX=/path/to/gtsam-4.2.0
CMAKE_PREFIX_PATH="${GTSAM_PREFIX}${CMAKE_PREFIX_PATH:+:${CMAKE_PREFIX_PATH}}"
LD_LIBRARY_PATH="${GTSAM_PREFIX}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
